{
    "name": "querycraft-server",
    "version": "1.0.0",
    "description": "Backend for QueryCraft",
    "main": "index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "migrate:dev": "prisma migrate dev",
        "migrate:deploy": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:studio": "prisma studio",
        "eval:semantic-diff": "npx tsx --env-file=.env scripts/eval-semantic-diff.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "^5.10.2",
        "@sentry/node": "^10.53.1",
        "@sentry/react": "^10.53.1",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.18.3",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "lru-cache": "^11.3.6",
        "mysql2": "^3.22.3",
        "node-sql-parser": "^5.4.0",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "resend": "^6.12.3",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.11.24",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.0",
        "@types/swagger-ui-express": "^4.1.8",
        "@vitest/ui": "^4.1.6",
        "jsdom": "^29.1.1",
        "prisma": "^5.10.2",
        "supertest": "^7.2.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3",
        "vitest": "^4.1.6"
    }
}
