# AI Provider — configure one. Local LLM runs free with no API key.
# Local LLM — install from https://ollama.com, then: ollama pull <model>
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=120000
# Cloud AI providers — local LLM takes priority when OLLAMA_MODEL is set
GEMINI_API_KEY=your_api_key
OPENAI_API_KEY=your_api_key
ANTHROPIC_API_KEY=your_api_key
GROQ_API_KEY=your_api_key

# Database — SQLite for dev, PostgreSQL for prod
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/querycraft"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here
JWT_EXPIRES_IN=7d

# Server
PORT=3000
LOG_LEVEL=info

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com
